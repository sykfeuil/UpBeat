<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UpBeat.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:UpBeat.Views"
    Title="UpBeat">

    <TabBar>
        <ShellContent
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Icon="tab_search.png"
            ContentTemplate="{DataTemplate views:SearchPage}"
            Route="search" />

        <ShellContent
            Icon="tab_playlists.png"
            ContentTemplate="{DataTemplate views:PlaylistsPage}"
            Route="playlists" />
    </TabBar>

</Shell>
