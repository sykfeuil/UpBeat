<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:UpBeat.Converters"
             xmlns:viewModels="clr-namespace:UpBeat.ViewModels"
             x:Class="UpBeat.Controls.MiniPlayerView"
             x:DataType="viewModels:PlayerViewModel">

    <ContentView.Resources>
        <converters:DurationConverter x:Key="DurationConverter" />
    </ContentView.Resources>

    <Border IsVisible="{Binding HasCurrentTrack}"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource NeonRed}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="16,8,16,4"
            Margin="0,0,0,12">
        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">

            <!-- Current track -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding CurrentTrack.Title}"
                       TextColor="White"
                       FontSize="14"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding CurrentTrack.Author}"
                       TextColor="{StaticResource Gray300}"
                       FontSize="12"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{StaticResource NeonRed}"
                       FontSize="12" />
            </VerticalStackLayout>

            <!-- Play/pause: the icon follows the playing state -->
            <ImageButton Grid.Row="0" Grid.Column="1"
                         Source="icon_play.png"
                         Command="{Binding TogglePlayPauseCommand}"
                         WidthRequest="40"
                         HeightRequest="40"
                         Padding="4"
                         BackgroundColor="Transparent">
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsPlaying}" Value="True">
                        <Setter Property="Source" Value="icon_pause.png" />
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>

            <!-- Progress bar: drag it to move within the track -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="4">
                <Label Grid.Column="0"
                       Text="{Binding Position, Converter={StaticResource DurationConverter}}"
                       TextColor="{StaticResource Gray300}"
                       FontSize="11"
                       VerticalOptions="Center" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds}"
                        MinimumTrackColor="{StaticResource NeonRed}"
                        MaximumTrackColor="{StaticResource Muted}"
                        ThumbColor="{StaticResource NeonRed}"
                        DragStartedCommand="{Binding BeginSeekCommand}"
                        DragCompletedCommand="{Binding EndSeekCommand}" />
                <Label Grid.Column="2"
                       Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                       TextColor="{StaticResource Gray300}"
                       FontSize="11"
                       VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Border>

</ContentView>
