<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:UpBeat.Controls"
             xmlns:models="clr-namespace:UpBeat.Models"
             xmlns:viewModels="clr-namespace:UpBeat.ViewModels"
             x:Class="UpBeat.Views.PlaylistsPage"
             x:DataType="viewModels:PlaylistsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="16,16,16,0"
          RowSpacing="16">

        <!-- Header: title and "new playlist" button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="Playlists"
                   TextColor="White"
                   FontSize="26"
                   FontFamily="JetBrainsMonoBold"
                   VerticalOptions="Center" />
            <ImageButton Grid.Column="1"
                         Source="icon_add.png"
                         Command="{Binding CreatePlaylistCommand}"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="6"
                         BackgroundColor="Transparent" />
        </Grid>

        <!-- Search field to find playlists to import -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Muted}"
                StrokeThickness="2"
                StrokeShape="{StaticResource PixelFrame}"
                Padding="4,0">
            <SearchBar x:Name="SearchInput"
                       Text="{Binding Query}"
                       SearchButtonPressed="OnSearchButtonPressed"
                       Placeholder="Search playlists to import"
                       PlaceholderColor="{StaticResource Muted}"
                       TextColor="White"
                       SearchIconColor="{StaticResource NeonRed}"
                       CancelButtonColor="{StaticResource NeonRed}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- User's playlists: tap to open, long press to rename or delete -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Playlists}"
                        IsVisible="{Binding IsListMode}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistSummary">
                    <Border BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Muted}"
                            StrokeThickness="2"
                            StrokeShape="{StaticResource PixelFrame}"
                            Padding="16,12">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedOpacity="0.6"
                                                   TouchGestureCompleted="OnPlaylistTapped"
                                                   LongPressCompleted="OnPlaylistLongPressed" />
                        </Border.Behaviors>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}"
                                   TextColor="White"
                                   FontSize="17"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TrackCountText}"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Found playlists: tap to import -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding SearchResults}"
                        IsVisible="{Binding IsSearchMode}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistResult">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          Padding="8,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportPlaylistCommand, Source={RelativeSource AncestorType={x:Type viewModels:PlaylistsViewModel}}, x:DataType=viewModels:PlaylistsViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <controls:TrackThumbnail Grid.Column="0"
                                                 Url="{Binding ThumbnailUrl}"
                                                 VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   TextColor="White"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Author}"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty state (no playlists yet) or search message -->
        <Label Grid.Row="2"
               Text="No playlists yet.&#10;Tap + to create one, or search one to import."
               IsVisible="{Binding ShowEmptyState}"
               TextColor="{StaticResource Gray300}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,32,0,0" />
        <Label Grid.Row="2"
               Text="{Binding SearchMessage}"
               IsVisible="{Binding HasSearchMessage}"
               TextColor="{StaticResource Gray300}"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,32,0,0" />

        <!-- Loading indicator while searching or importing -->
        <controls:PixelLoader Grid.Row="2"
                               IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               Margin="0,32,0,0" />

        <controls:MiniPlayerView Grid.Row="3" />

    </Grid>

</ContentPage>
