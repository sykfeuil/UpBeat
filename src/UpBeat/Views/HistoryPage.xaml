<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UpBeat.Controls"
             xmlns:converters="clr-namespace:UpBeat.Converters"
             xmlns:models="clr-namespace:UpBeat.Models"
             xmlns:viewModels="clr-namespace:UpBeat.ViewModels"
             x:Class="UpBeat.Views.HistoryPage"
             x:DataType="viewModels:HistoryViewModel">

    <ContentPage.Resources>
        <converters:DurationConverter x:Key="DurationConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16,16,16,0"
          RowSpacing="16">

        <Label Grid.Row="0"
               Text="Recently played"
               TextColor="White"
               FontSize="26"
               FontFamily="JetBrainsMonoBold" />

        <!-- History: the most recent first, tap to play again -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Entries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryEntry">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          Padding="8,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PlayTrackCommand, Source={RelativeSource AncestorType={x:Type viewModels:HistoryViewModel}}, x:DataType=viewModels:HistoryViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <controls:TrackThumbnail Grid.Column="0"
                                                 Url="{Binding ThumbnailUrl}"
                                                 VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   TextColor="White"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Author}"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                               TextColor="{StaticResource Gray300}"
                               FontSize="13"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty state -->
        <Label Grid.Row="1"
               Text="Nothing played yet.&#10;Tracks you listen to will appear here."
               IsVisible="{Binding IsEmpty}"
               TextColor="{StaticResource Gray300}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,32,0,0" />

        <controls:MiniPlayerView Grid.Row="2" />

    </Grid>

</ContentPage>
