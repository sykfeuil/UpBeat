<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:UpBeat.Controls"
             xmlns:converters="clr-namespace:UpBeat.Converters"
             xmlns:models="clr-namespace:UpBeat.Models"
             xmlns:viewModels="clr-namespace:UpBeat.ViewModels"
             x:Class="UpBeat.Views.SearchPage"
             x:DataType="viewModels:SearchViewModel">

    <ContentPage.Resources>
        <converters:DurationConverter x:Key="DurationConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16,16,16,0"
          RowSpacing="16">

        <!-- Search field with a neon glow -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource NeonRed}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 24"
                Padding="4,0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource NeonRedBrush}"
                        Radius="16"
                        Opacity="0.6"
                        Offset="0,0" />
            </Border.Shadow>

            <SearchBar x:Name="SearchInput"
                       Text="{Binding Query}"
                       SearchCommand="{Binding SearchCommand}"
                       SearchButtonPressed="OnSearchButtonPressed"
                       Placeholder="Search"
                       PlaceholderColor="{StaticResource Muted}"
                       TextColor="White"
                       SearchIconColor="{StaticResource NeonRed}"
                       CancelButtonColor="{StaticResource NeonRed}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- Search results: tap to play, long press to add to a playlist -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Padding="8,10">
                        <Grid.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource Surface}"
                                                   TouchGestureCompleted="OnResultTapped"
                                                   LongPressCompleted="OnResultLongPressed" />
                        </Grid.Behaviors>

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Title}"
                                   TextColor="White"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Author}"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                               TextColor="{StaticResource Gray300}"
                               FontSize="13"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- "No results" or error message -->
        <Label Grid.Row="1"
               Text="{Binding Message}"
               IsVisible="{Binding HasMessage}"
               TextColor="{StaticResource Gray300}"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,32,0,0" />

        <!-- Loading indicator while searching -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding SearchCommand.IsRunning}"
                           Color="{StaticResource NeonRed}"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           Margin="0,32,0,0" />

        <controls:MiniPlayerView Grid.Row="2" />

    </Grid>

</ContentPage>
